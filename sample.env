### 
###  -----------------------------------------------------
###  N A S - D O C K E R   C O N F I G   S E T T I N G S
###  -----------------------------------------------------
###  The values configured here are applied during
###  $ docker-compose up
###  -----------------------------------------------
###  DOCKER-COMPOSE ENVIRONMENT VARIABLES BEGIN HERE
###  -----------------------------------------------
###

LOCALUSER=
HOSTNAME=
IP_ADDRESS=
PUID=
PGID=
LOG_FILE_NUM=5
LOG_FILE_SIZE=10m
TZ=
BASE_DOCKER_PATH=/volume1/docker
SPOOLMAN_PORT=
BAMBUAMS_PORT=
SPOOLMAN_ENDPOINT=http(s)://<spoolman_ip_address>:<spoolman_port>[/<spoolman_subfolder>]
UPDATE_INTERVAL=120000
BAMBUAMS_MODE=automatic